# ============ Supabase ============
# Supabase -> Project Settings -> Database -> Connection string -> URI
#
# DATABASE_URL is what the API uses: many short queries, no session state to keep, so the
# TRANSACTION pooler (6543) suits it. api/db.py already passes prepare_threshold=None,
# which is what that port requires. The session pooler (5432) works here too.
#
# Do NOT append ?pgbouncer=true. Supabase's docs show it because Prisma needs it; libpq
# does not know the parameter and rejects the whole URI with
#   invalid URI query parameter: "pgbouncer"
# so every connection fails and it reads as a wrong password.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Optional. Migrations are the opposite shape to API traffic -- long multi-statement DDL --
# so ./run.sh migrate prefers the SESSION pooler (5432) when this is set, and falls back to
# DATABASE_URL when it is not.
DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...        # service_role key, NEVER the anon key, NEVER in the browser

# ============ AI / LLM ============
# You can use Gemini API (e.g. Gemini 3.6 Flash) OR Anthropic API (Claude)
GEMINI_API_KEY=AIzaSy...
# ANTHROPIC_API_KEY=sk-ant-...
MODEL_VISION=gemini-3.6-flash
MODEL_CHAT=gemini-3.6-flash

# ============ Wiring ============
SHARED_SECRET=generate-with-openssl-rand-hex-32

# Which WhatsApp transport to use.
#   gowa    = go-whatsapp-web-multidevice (wa-gowa/docker-compose.yml). Multi-device,
#             so one server can hold a separate account per pharmacy. Use this.
#   baileys = the original wa-gateway/ node service. One device per server.
WA_BACKEND=gowa
WA_GATEWAY_URL=http://localhost:3000

# ============ GOWA (when WA_BACKEND=gowa) ============
GOWA_URL=http://localhost:3001
GOWA_USER=pharmaos
GOWA_PASS=generate-with-openssl-rand-hex-16
# HMAC secret for inbound webhooks. GOWA's own default is the literal word "secret",
# which would let anyone who can reach /webhook/gowa forge a staff message and move
# stock. Set it here AND as WHATSAPP_WEBHOOK_SECRET on the GOWA container.
GOWA_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32
# Where GOWA should POST inbound messages. host.docker.internal reaches your laptop.
GOWA_WEBHOOK_URL=http://host.docker.internal:8000/webhook/gowa
# The GOWA device SLOT id -- a name you choose, e.g. pharmacy-1. NOT a JID: we send it
# as the X-Device-Id header (api/wa.py), and GOWA matches it against the slot ids from
# GET /devices. A JID here would not match any slot. Optional with one device; REQUIRED
# once a second pharmacy is paired, or GOWA cannot tell which account should send.
GOWA_DEVICE_ID=pharmacy-1
API_URL=http://localhost:8000
PUBLIC_BASE_URL=https://your-api.up.railway.app
PHARMACY_ID=                              # uuid from the pharmacies row you insert in step 3

# ============ M-Pesa Daraja ============
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://your-api.up.railway.app/mpesa/callback

# ============ Business rules ============
MIN_SHELF_LIFE_DAYS=60
RX_MAX_AGE_DAYS=90
MATCH_THRESHOLD=0.55
LINE_CONF_THRESHOLD=0.75
POINTS_PER_KES=100
DELIVERY_FEE=150

# ============ Dashboard ============
DASHBOARD_PASSWORD=change-me

# ============ Auth ============
# shared    one DASHBOARD_PASSWORD for everyone (default; the original behaviour)
# whatsapp  per-user sign-in with a 6-digit code sent over WhatsApp.
#           The shared password KEEPS WORKING alongside it as a break-glass.
# strict    per-user only; the shared password is refused.
# Roll out as shared -> whatsapp -> (once everyone has signed in once) strict.
AUTH_MODE=shared

# Make the DATABASE enforce tenant isolation (Phase 2). Off by default.
# Even when true this only affects code inside db.tenant_scope(); the existing
# helpers still rely on hand-written `where pharmacy_id = %s`. See AUTH.md.
DB_ENFORCE_RLS=false

# --- anti-ban safety gates ---
# Gate 1. Comma-separated numbers that are allowed to RECEIVE messages. When set, nothing
# can reach anyone else -- the strongest protection against a ban while developing, and
# the reason an accidental send to a stranger becomes impossible. Leave EMPTY in
# production, where Gates 2-4 are the real posture. Verify with: ./run.sh safety
WA_ALLOWLIST=
# Gate 4, per GOWA device. Deliberately conservative.
WA_RATE_LIMIT_HOUR=80
WA_NEW_CHAT_LIMIT_HOUR=15
# Bulk sending. A batch larger than the cap is refused, never truncated.
WA_BROADCAST_MAX=25
WA_PACE_MIN_SECS=4
WA_PACE_MAX_SECS=11
