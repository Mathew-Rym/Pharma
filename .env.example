# ============ Supabase ============
# Supabase -> Project Settings -> Database -> Connection string -> URI
# Use the SESSION POOLER string (port 5432) if you can; if you use the transaction
# pooler (6543) our psycopg config already sets prepare_threshold=None for you.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...        # service_role key, NEVER the anon key, NEVER in the browser

# ============ Anthropic ============
