; Dishii bridge agent — copy to config.ini on the pharmacy PC and fill in.
; Nothing here is a secret except enrolment_token, which is single-use.

[cloud]
; The deployed API, no trailing slash.
api_url = https://your-api.up.railway.app
; uuid of the pharmacies row
pharmacy_id =
; Generated on the dashboard: System -> Pharmacy PC agent -> Generate enrolment token.
; Used once, then exchanged for a per-install agent_token stored in agent.db.
enrolment_token =

[agent]
; Where agent.db (the offline outbox) and the log file live.
data_dir = C:\Dishii\data
log_file = C:\Dishii\dishii-agent.log

[ingest]
; Leave mode blank to let the probe decide (db_poll if it finds a readable DB,
; otherwise folder_watch).
mode =
; phAMACore exports get saved here. The agent creates processed\ and rejected\
; subfolders itself. Files it cannot classify land in rejected\ with a .reason.txt
; rather than disappearing.
watch_dir = C:\Dishii\exports

[phamacore]
; Optional hint for the probe. If blank it still checks the usual install paths.
install_dir =

; ----------------------------------------------------------------------------
; Only fill this in AFTER running `python agent.py --probe-only` and confirming
; with the pharmacy owner IN WRITING that reading the vendor's database is
; permitted. The agent is read-only, but the authorisation is not ours to assume.
;
; sales_query MUST take exactly one parameter: the high-water mark, and MUST
; return columns named (or aliased to): sale_id, sale_datetime, item_code,
; description, quantity, unit_price, line_total, payment_method
; ----------------------------------------------------------------------------
; [database]
; engine = odbc
; connection_string = DSN=phamacore;UID=readonly;PWD=...
; sales_query = select top 5000 s.id as sale_id, s.sold_at as sale_datetime,
;                      i.code as item_code, i.name as description,
;                      l.qty as quantity, l.price as unit_price,
;                      l.total as line_total, s.tender as payment_method
;                 from sale_lines l join sales s on s.id = l.sale_id
;                 join items i on i.id = l.item_id
;                where s.id > ? order by s.id
